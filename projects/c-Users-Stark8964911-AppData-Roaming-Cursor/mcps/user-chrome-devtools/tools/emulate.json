{
  "name": "emulate",
  "description": "Emulates various features on the selected page.",
  "arguments": {
    "type": "object",
    "properties": {
      "networkConditions": {
        "type": "string",
        "enum": [
          "No emulation",
          "Offline",
          "Slow 3G",
          "Fast 3G",
          "Slow 4G",
          "Fast 4G"
        ],
        "description": "Throttle network. Set to \"No emulation\" to disable. If omitted, conditions remain unchanged."
      },
      "cpuThrottlingRate": {
        "type": "number",
        "minimum": 1,
        "maximum": 20,
        "description": "Represents the CPU slowdown factor. Set the rate to 1 to disable throttling. If omitted, throttling remains unchanged."
      },
      "geolocation": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Latitude between -90 and 90."
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Longitude between -180 and 180."
              }
            },
            "required": [
              "latitude",
              "longitude"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "Geolocation to emulate. Set to null to clear the geolocation override."
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}