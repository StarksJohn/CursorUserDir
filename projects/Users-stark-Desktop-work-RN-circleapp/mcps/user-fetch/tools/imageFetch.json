{
  "name": "imageFetch",
  "description": "\n画像取得に強いMCPフェッチツール。記事本文をMarkdown化し、ページ内の画像を抽出・最適化して返します。\n\n新APIの既定（imagesを指定した場合）\n- 画像: 取得してBASE64で返却（最大3枚を縦結合した1枚JPEG）\n- 保存: しない（オプトイン）\n- クロスオリジン: 許可（CDN想定）\n\nパラメータ（新API）\n- url: 取得先URL（必須）\n- images: true | { output, layout, maxCount, startIndex, size, originPolicy, saveDir }\n  - output: \"base64\" | \"file\" | \"both\"（既定: base64）\n  - layout: \"merged\" | \"individual\" | \"both\"（既定: merged）\n  - maxCount/startIndex（既定: 3 / 0）\n  - size: { maxWidth, maxHeight, quality }（既定: 1000/1600/80）\n  - originPolicy: \"cross-origin\" | \"same-origin\"（既定: cross-origin）\n- text: { maxLength, startIndex, raw }（既定: 20000/0/false）\n- security: { ignoreRobotsTxt }（既定: false）\n\n旧APIキー（enableFetchImages, returnBase64, saveImages, imageMax*, imageStartIndex 等）は後方互換のため引き続き受け付けます（非推奨）。\n\nExamples（新API）\n{\n  \"url\": \"https://example.com\",\n  \"images\": true\n}\n\n{\n  \"url\": \"https://example.com\",\n  \"images\": { \"output\": \"both\", \"layout\": \"both\", \"maxCount\": 4 }\n}\n\nExamples（旧API互換）\n{\n  \"url\": \"https://example.com\",\n  \"enableFetchImages\": true,\n  \"returnBase64\": true,\n  \"imageMaxCount\": 2\n}",
  "arguments": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri"
      },
      "maxLength": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        ],
        "default": 20000
      },
      "startIndex": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 0
          }
        ],
        "default": 0
      },
      "imageStartIndex": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 0
          }
        ],
        "default": 0
      },
      "raw": {
        "type": [
          "boolean",
          "string"
        ],
        "default": false
      },
      "imageMaxCount": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        ],
        "default": 3
      },
      "imageMaxHeight": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 100,
            "maximum": 10000
          }
        ],
        "default": 4000
      },
      "imageMaxWidth": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 100,
            "maximum": 10000
          }
        ],
        "default": 1000
      },
      "imageQuality": {
        "allOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        ],
        "default": 80
      },
      "enableFetchImages": {
        "type": [
          "boolean",
          "string"
        ],
        "default": false
      },
      "allowCrossOriginImages": {
        "type": [
          "boolean",
          "string"
        ],
        "default": true
      },
      "ignoreRobotsTxt": {
        "type": [
          "boolean",
          "string"
        ],
        "default": false
      },
      "saveImages": {
        "type": [
          "boolean",
          "string"
        ],
        "default": true
      },
      "returnBase64": {
        "type": [
          "boolean",
          "string"
        ],
        "default": false
      },
      "images": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "output": {
                "type": "string",
                "enum": [
                  "base64",
                  "file",
                  "both"
                ]
              },
              "layout": {
                "type": "string",
                "enum": [
                  "merged",
                  "individual",
                  "both"
                ]
              },
              "maxCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "startIndex": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "object",
                "properties": {
                  "maxWidth": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  },
                  "maxHeight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              },
              "originPolicy": {
                "type": "string",
                "enum": [
                  "cross-origin",
                  "same-origin"
                ]
              },
              "saveDir": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "text": {
        "type": "object",
        "properties": {
          "maxLength": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "startIndex": {
            "type": "integer",
            "minimum": 0
          },
          "raw": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "security": {
        "type": "object",
        "properties": {
          "ignoreRobotsTxt": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}