[
    // Ctrl+D: Delete selected lines (override default "add selection to next find match")
    {
        "key": "ctrl+d",
        "command": "-editor.action.addSelectionToNextFindMatch"
    },
    {
        "key": "ctrl+d",
        "command": "editor.action.deleteLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Move "add selection to next find match" to Ctrl+Shift+D
    {
        "key": "ctrl+shift+d",
        "command": "editor.action.addSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "f9",
        "command": "-editor.debug.action.toggleBreakpoint"
    },
    {
        "key": "f9",
        "command": "editor.action.deleteLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+f9",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "debuggersAvailable && editorTextFocus"
    },
    {
        "key": "ctrl+/",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+/",
        "command": "editor.action.blockComment",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+/",
        "command": "-editor.action.commentLine"
    },
    {
        "key": "alt+shift+/",
        "command": "-editor.action.blockComment"
    },
    {
        "key": "ctrl+i",
        "command": "composerMode.agent"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\\\r\n"
        },
        "when": "terminalFocus"
    },
    // Ctrl+Q: Copy current file's absolute path to clipboard
    {
        "key": "ctrl+q",
        "command": "copyFilePath",
        "when": "editorFocus"
    },
    // Also work in explorer view
    {
        "key": "ctrl+q",
        "command": "copyFilePath",
        "when": "explorerViewletFocus"
    },
    // ========== Paste Image Configuration for Markdown Files ==========
    // Alt+V (physical Ctrl+V after AHK swap): Trigger Paste Image in Markdown files
    // Priority 1: Always use Paste Image plugin in Markdown files
    {
        "key": "alt+v",
        "command": "extension.pasteImage",
        "when": "editorLangId == markdown && editorTextFocus"
    },
    // Ctrl+V (direct, without AHK): Also trigger Paste Image in Markdown files
    // This handles cases where AHK might not intercept the keystroke
    {
        "key": "ctrl+v",
        "command": "extension.pasteImage",
        "when": "editorLangId == markdown && editorTextFocus"
    },
    // Ctrl+Shift+V: Force normal paste in Markdown (bypass Paste Image)
    {
        "key": "ctrl+shift+v",
        "command": "editor.action.clipboardPasteAction",
        "when": "editorLangId == markdown && editorTextFocus"
    },
    // ========== Normal Paste for Non-Markdown Files ==========
    // Alt+V (physical Ctrl+V after AHK swap): Normal paste in non-Markdown files
    {
        "key": "alt+v",
        "command": "editor.action.clipboardPasteAction",
        "when": "editorLangId != markdown && editorTextFocus"
    },
    // Alt+V: Normal paste in other contexts (terminal, input boxes, etc.)
    {
        "key": "alt+v",
        "command": "editor.action.clipboardPasteAction",
        "when": "!editorTextFocus"
    }
]