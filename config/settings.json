    // ========== Terminal Configuration ==========
    // Make Terminal behave like an editor tab
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.location": "left",
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.rightClickBehavior": "copyPaste",
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    // ========== Paste Image Plugin Configuration ==========
    // Global configuration for pasting images in Markdown files
    "pasteImage.path": "${currentFileDir}",
    "pasteImage.basePath": "${currentFileDir}",
    "pasteImage.forceUnixStyleSeparator": true,
    "pasteImage.prefix": "",
    "pasteImage.defaultName": "img_",
    "pasteImage.namePrefix": "img_",
    "pasteImage.insertPattern": "![${imageFileName}](${imageFilePath})",
    "pasteImage.showFilePathConfirmInputBox": false,
    "pasteImage.filePathConfirmInputBoxMode": "fullPath",
    "pasteImage.encodePath": "none",

    // ========== Path Intellisense Configuration ==========
    // Path alias for common project structures
    "path-intellisense.mappings": {
        "@": "${workspaceFolder}/src",
        "components": "${workspaceFolder}/src/components",
        "pages": "${workspaceFolder}/src/pages",
        "tools": "${workspaceFolder}/src/tools",
        "useHooks": "${workspaceFolder}/src/useHooks",
        "@api": "${workspaceFolder}/src/api"
    },
    "path-intellisense.autoSlashAfterDirectory": true,
    "path-intellisense.autoTriggerNextSuggestion": true,
    "path-intellisense.extensionOnImport": false,
    "path-intellisense.showHiddenFiles": false,

    // ========== Auto Close/Rename Tag ==========
    "auto-close-tag.activationOnLanguage": [
        "xml",
        "php",
        "blade",
        "ejs",
        "jinja",
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "plaintext",
        "markdown",
        "vue",
        "liquid",
        "erb",
        "lang-cfml",
        "cfml",
        "HTML (EEx)",
        "HTML (Eex)",
        "plist"
    ],
    "auto-rename-tag.activationOnLanguage": [
        "html",
        "xml",
        "php",
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "vue"
    ],

    // ========== Error Lens Configuration ==========
    "errorLens.enabled": true,
    "errorLens.enabledDiagnosticLevels": ["error", "warning"],
    "errorLens.delay": 500,
    "errorLens.fontStyleItalic": true,
    "errorLens.messageMaxChars": 200
}
